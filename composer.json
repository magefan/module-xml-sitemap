{
  "name": "magefan/module-xml-sitemap",
  "description": "Magefan XML Sitemap for Magento 2",
  "require": {
    "magefan/module-community" : ">=2.2.15"
  },
  "type": "magento2-module",
  "version": "2.1.1",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Magefan\\XmlSitemap\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
